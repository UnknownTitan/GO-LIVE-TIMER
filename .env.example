# PostgreSQL connection
DATABASE_URL=postgres://localhost:5432/golive

# Port the API (and built frontend) listens on
PORT=3000

# Set to "production" behind HTTPS so the session cookie is marked Secure
NODE_ENV=development

# Public URL of the countdown page, used in reminder emails
APP_URL=http://localhost:5173

# SMTP relay for the daily reminder. Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CLET Go-Live Countdown <no-reply@example.org>"

# Set to "false" to disable the 18:00 reminder job in this process (e.g. on staging)
REMINDER_CRON_ENABLED=true
